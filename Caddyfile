finsight-api.duckdns.org {
	encode zstd gzip

	# The API is the only surface this host serves. Internet-wide scanners probe
	# constantly for .env files, cloud credentials and admin panels; answering
	# them here keeps that traffic off the application and out of its logs.
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		respond 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
