# LLM
LLM_PROVIDER=openai                    # openai | ollama
OPENAI_API_KEY=                        # obligatoria siempre: los embeddings del grafo la usan sin importar LLM_PROVIDER
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Servicios externos
# Wait 60 seconds before connecting using these details, or login to https://console.neo4j.io to validate the Aura Instance is available
NEO4J_URI=                             # usar neo4j+ssc:// en lugar de neo4j+s:// para evitar SSL cert errors en Windows
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=
NEWSAPI_KEY=
FINNHUB_API_KEY=

# Noticias (proveedor primario; el otro actúa como fallback)
NEWS_PROVIDER=finnhub                  # finnhub | newsapi

# Aplicación
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development                # development | production

# Caché (segundos)
CACHE_TTL_SENTIMENT=1800               # 30 min
CACHE_TTL_FUNDAMENTAL=86400            # 1 día
CACHE_TTL_TECHNICAL=86400              # 1 día
CACHE_TTL_SEARCH=86400                 # 1 día

# Parámetros de análisis
PREDICTION_HORIZON_DAYS=10
MAX_NEWS_ARTICLES=10
GRAPH_HOP_DEPTH=2
LRU_CACHE_MAX_MODELS=10
DL_MAX_SKILL_RATIO=1.0                 # rmse_modelo/rmse_naive máximo para publicar un modelo GRU
DL_FORCE_PUBLISH_TICKERS=              # símbolos separados por comas publicados pese a no superar el umbral

# Rate limiting (peticiones por ventana por IP de cliente)
RATE_LIMIT_REPORT=10/minute
RATE_LIMIT_ANALYSIS=10/minute
RATE_LIMIT_SEARCH=60/minute

# Análisis fundamental
FUNDAMENTAL_DATA_DIR=                  # vacío → ubicación por defecto del paquete engine
